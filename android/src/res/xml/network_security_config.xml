<?xml version="1.0" encoding="utf-8"?>
<!-- AgentTelecast is usually served over plain HTTP from a computer on your home network.
     Android can't allow cleartext for "any local address" in a domain-config, so cleartext
     is permitted app-wide. Only point this app at URLs you trust. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
